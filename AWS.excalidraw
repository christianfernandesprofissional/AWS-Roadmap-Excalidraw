    },
    {
      "id": "MGhviTO9lXPOAS2durW5-",
      "type": "text",
      "x": 2095.3283498378446,
      "y": -3307.7296615871446,
      "width": 257.9115577763304,
      "height": 250.70330140757437,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hHaXEvZNrKXAjbE1cqMi1",
        "HtGDiaBA8f18mdqd7twQt",
        "zfrP9l9nyvWMsu0M7hS_w"
      ],
      "frameId": null,
      "index": "bYI",
      "roundness": null,
      "seed": 653902257,
      "version": 514,
      "versionNonce": 1292862710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764264372807,
      "link": null,
      "locked": false,
      "text": "SIMPLE ROUTING\n\nRoteamento básico (1 endpoint).\n\nSem regras ou lógica.\n\nCaso tenha vários registros com o\nmesmo nome, ele retorna todos em\nordem aleatória (cliente escolhe um).\n\nQuando usar: Aplicações simples com\napenas um recurso.\n\nMemorizar: \"Simple = 1 endpoint, sem\nlógica\".",
      "fontSize": 13.3708427417373,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SIMPLE ROUTING\n\nRoteamento básico (1 endpoint).\n\nSem regras ou lógica.\n\nCaso tenha vários registros com o mesmo nome, ele retorna todos em ordem aleatória (cliente escolhe um).\n\nQuando usar: Aplicações simples com apenas um recurso.\n\nMemorizar: \"Simple = 1 endpoint, sem lógica\".",
      "autoResize": false,
      "lineHeight": 1.25
    },
