      "link": null,
      "locked": false,
      "text": "Cada Região tem pelo\nmenos 3 AZ, e cada\nAZ é constituída de\num ou mais\ndatacenters ",
      "fontSize": 18.744836392290438,
      "fontFamily": 5,
      "textAlign": "center",
