    {
      "id": "fBKZv5z1-1_ZHZfm8ubd4",
      "type": "text",
      "x": 240.757808524658,
      "y": -1521.6541027060139,
      "width": 335.376742539612,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
