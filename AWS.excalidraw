      "boundElements": [],
      "updated": 1764878786770,
      "link": null,
      "locked": false,
      "text": "Amazon EKS -\nElastic\nKubernetes\nService",
      "fontSize": 9.302519013846156,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amazon EKS - Elastic Kubernetes Service",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "H44Ya7xgbP5hnFKwEkdS1",
      "type": "text",
      "x": -1391.11509803607,
      "y": -3158.4967518746435,
      "width": 174.83109838884184,
      "height": 91.68522244689531,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Nd8IzYPUVf0SSDIVwEzHH",
        "hD8u3bB7kRjOX_XGaohJQ"
      ],
      "frameId": null,
      "index": "be2",
      "roundness": null,
      "seed": 1680995772,
      "version": 984,
      "versionNonce": 710771332,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764878786770,
      "link": null,
      "locked": false,
      "text": "Serviço gerenciado de Kubernetes.\nEle simplifica a criação, operação e\nescalabilidade de clusters Kubernetes,\nremovendo a parte mais complexa do\ngerenciamento da infraestrutura.\nCom o EKS, você usa Kubernetes padrão,\nmas sem precisar configurar masters,\ncontrol-plane, upgrades ou alta\ndisponibilidade — a AWS gerencia tudo isso.",
      "fontSize": 8.149797550835139,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serviço gerenciado de Kubernetes.\nEle simplifica a criação, operação e escalabilidade de clusters Kubernetes, removendo a parte mais complexa do gerenciamento da infraestrutura.\nCom o EKS, você usa Kubernetes padrão, mas sem precisar configurar masters, control-plane, upgrades ou alta disponibilidade — a AWS gerencia tudo isso.",
      "autoResize": false,
      "lineHeight": 1.25
    },
