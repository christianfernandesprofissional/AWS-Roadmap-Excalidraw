    {
      "id": "vhDdDx7_QUmHo7WcTmJXa",
      "type": "text",
      "x": 1645.3336931072351,
      "y": -2154.234214900497,
      "width": 364.56758950374484,
      "height": 139.8113890452827,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9FPfyZkT642QN_B7Qt1qD",
        "HW35IvPQjVbZQqlWyKQfU",
        "as_xlB9Z6HpHNJc3ASEvH"
      ],
      "frameId": null,
      "index": "bTY",
      "roundness": null,
      "seed": 1789800173,
      "version": 792,
      "versionNonce": 2124881330,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764183839138,
      "link": null,
      "locked": false,
      "text": "Link direto entre duas VPCs, mas não suporta\nroteamento transitivo (ou seja, não dá para\nVPC A falar com C passando por B). Para\nambientes maiores, é melhor usar o Transit\nGateway, que funciona como um hub central\nconectando várias VPCs e redes locais e\npermite roteamento transitivo.",
      "fontSize": 15.978444462318024,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Link direto entre duas VPCs, mas não suporta roteamento transitivo (ou seja, não dá para VPC A falar com C passando por B). Para ambientes maiores, é melhor usar o Transit Gateway, que funciona como um hub central conectando várias VPCs e redes locais e permite roteamento transitivo.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "meXbqnJNL-oQmhG0Qk_5a",
      "type": "text",
      "x": 1152.5594889356105,
