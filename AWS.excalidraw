      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877384187,
      "link": null,
      "locked": false,
      "text": "Um conjunto de boas práticas criado pela AWS para ajudar arquitetos e desenvolvedores a projetar sistemas seguros, eficientes,\nresilientes e otimizados na nuvem. Ele serve como um guia para avaliar se uma arquitetura está adequada e identificar melhorias.",
      "fontSize": 30.19300054493333,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Um conjunto de boas práticas criado pela AWS para ajudar arquitetos e desenvolvedores a projetar sistemas seguros, eficientes, resilientes e otimizados na nuvem. Ele serve como um guia para avaliar se uma arquitetura está adequada e identificar melhorias.",
      "autoResize": false,
      "lineHeight": 1.25
    },
