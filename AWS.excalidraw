    {
      "id": "TO6k05EVu-M0sy9N5kxz8",
      "type": "text",
      "x": 3122.7947307141885,
      "y": -2834.673992164147,
      "width": 214.80335477557009,
      "height": 50.56399807271484,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
