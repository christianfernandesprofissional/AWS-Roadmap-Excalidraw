      "isDeleted": false,
      "boundElements": [],
      "updated": 1764876914714,
      "link": null,
      "locked": false,
      "text": "Leva serviços AWS para redes 5G, reduzindo\nlatência.\ncomputação dentro da rede 5G → latência\nultrabaixa para aplicações móveis e IoT.\nExecuta workloads bem próximo do usuário,\ndiretamente com operadoras de telecom.",
      "fontSize": 12.685100742859863,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leva serviços AWS para redes 5G, reduzindo latência.\ncomputação dentro da rede 5G → latência ultrabaixa para aplicações móveis e IoT.\nExecuta workloads bem próximo do usuário, diretamente com operadoras de telecom.",
      "autoResize": false,
      "lineHeight": 1.25
    },
