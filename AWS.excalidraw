      "groupIds": [
        "Eqqi73JRtvOiUnIDwU1xH",
        "0nHnS8LoZA8TJU_yx1LTp",
        "as_xlB9Z6HpHNJc3ASEvH"
      ],
      "frameId": null,
      "index": "bT1",
      "roundness": null,
      "seed": 553294134,
      "version": 2748,
      "versionNonce": 1679433774,
