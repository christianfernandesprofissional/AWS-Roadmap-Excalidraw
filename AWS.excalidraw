    {
      "id": "DfDsJwBEgvDyFj9ZkP6p0",
      "type": "text",
      "x": -1899.3223383659574,
      "y": 148.99119776289825,
      "width": 266.866111020158,
      "height": 129.6136517605625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bZo",
