      "isDeleted": false,
      "boundElements": [
        {
          "id": "kK75f3WHJUeitvS3v20Av",
          "type": "arrow"
        }
      ],
      "updated": 1764609844244,
      "link": null,
      "locked": false,
      "text": "Rota ativa: é o destino principal\n(primário), para onde o tráfego é\nenviado normalmente.",
      "fontSize": 13.483732819390625,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rota ativa: é o destino principal (primário), para onde o tráfego é enviado normalmente.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Pbd_5lIA4OAq0RLS5SAH_",
      "type": "text",
      "x": 3123.5641873884415,
      "y": -2767.2474502166433,
      "width": 226.87005020322565,
      "height": 50.56399807271484,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bZm",
      "roundness": null,
      "seed": 1161724472,
      "version": 186,
      "versionNonce": 1661639752,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764609849127,
      "link": null,
      "locked": false,
      "text": "Rota passiva: é o destino de\nbackup (secundário), que só recebe\no tráfego se a rota ativa falhar.",
      "fontSize": 13.483732819390625,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rota passiva: é o destino de backup (secundário), que só recebe o tráfego se a rota ativa falhar.",
      "autoResize": false,
      "lineHeight": 1.25
    },
