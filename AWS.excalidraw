    {
      "id": "8yBITQtY7fFUJoEInxLmA",
      "type": "text",
      "x": -386.07129387334703,
      "y": 1483.4987857264603,
      "width": 302.5377082294635,
      "height": 124.99371668501466,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TYKFNjx0YDm-AQkbJ9u2d"
      ],
      "frameId": null,
      "index": "ba3V",
      "roundness": null,
      "seed": 987590877,
      "version": 594,
      "versionNonce": 2080059315,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764789568521,
      "link": null,
      "locked": false,
      "text": "Um serviço que permite testar aplicações\nmobile e web em uma grande variedade de\ndispositivos reais hospedados na AWS. Ele\najuda a identificar falhas, bugs e problemas\nde compatibilidade antes da publicação,\nexecutando testes automatizados ou\nmanuais em smartphones e tablets reais.",
      "fontSize": 14.284996192573109,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Um serviço que permite testar aplicações mobile e web em uma grande variedade de dispositivos reais hospedados na AWS. Ele ajuda a identificar falhas, bugs e problemas de compatibilidade antes da publicação, executando testes automatizados ou manuais em smartphones e tablets reais.",
      "autoResize": false,
      "lineHeight": 1.25
    },
