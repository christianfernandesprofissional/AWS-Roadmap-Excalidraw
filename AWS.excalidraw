      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "x4n7Fp7WPVPXAkD_Tcwsy",
        "Xu-_bE45pOtIJ5bA1MrhQ",
        "C7m1ow5f5QC-rEuaAVaeK"
