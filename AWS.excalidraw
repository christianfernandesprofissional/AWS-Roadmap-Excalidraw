    {
      "id": "wtEwYmeRJ5uAaomaIfap5",
      "type": "text",
      "x": -1550.2323693682395,
      "y": 153.25601125951817,
      "width": 370.50289452951,
      "height": 68.84496093001205,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "p8KO7xuYKw8h-nhmpQju8",
        "Od54y6YZXviMWo_Ya97pO",
        "iOdt95jzDikVOjwg1LVgY",
        "P9m6q87AwoPyDweFH3R5v"
