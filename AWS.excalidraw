    {
      "id": "_K31Gztua6HmonvqcsW3-",
      "type": "text",
      "x": 985.9724837960498,
      "y": 700.255918467604,
      "width": 295.21869365594995,
      "height": 75.66497953437951,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "f-Z4oc8a2ZinD2UMJxUaM",
        "i3mgUS56dRyRmYsnPyocR"
      ],
      "frameId": null,
      "index": "bQH",
      "roundness": null,
      "seed": 244283608,
      "version": 1289,
      "versionNonce": 1034050948,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877010484,
      "link": null,
      "locked": false,
      "text": "Coleta, armazena e analisa logs de sistemas e aplicações.\nPode coletar logs de EC2 (via agente), Lambda, VPC Flow\nLogs, API Gateway, ECS, EKS, etc.\nPermite definir Log Retention (quanto tempo os logs são\nmantidos).\nPode filtrar log e gerar métricas com Metric Filters.",
      "fontSize": 10.088663937917268,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Coleta, armazena e analisa logs de sistemas e aplicações.\nPode coletar logs de EC2 (via agente), Lambda, VPC Flow Logs, API Gateway, ECS, EKS, etc.\nPermite definir Log Retention (quanto tempo os logs são mantidos).\nPode filtrar log e gerar métricas com Metric Filters.",
      "autoResize": false,
      "lineHeight": 1.25
    },
