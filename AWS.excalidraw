      "boundElements": [],
      "updated": 1764876930575,
      "link": null,
      "locked": false,
      "text": "Serviço DNS da AWS +\nregistro de domínio +\nroteamento inteligente de\ntráfego com health checks.\nPode ser configurado no\nnível de região. Shied\nAdvanced protege",
      "fontSize": 11.827691413627877,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serviço DNS da AWS + registro de domínio + roteamento inteligente de tráfego com health checks.\nPode ser configurado no nível de região. Shied Advanced protege",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "67EKk6n8tHKtX7Izjkxlw",
      "type": "text",
      "x": 2385.082665169018,
