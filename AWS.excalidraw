    {
      "id": "9I3ovwkzLuX5r--RX5UPt",
      "type": "text",
      "x": 1227.868240598652,
      "y": -463.3965259048249,
      "width": 368.3742616981841,
      "height": 136.4770392855499,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GcidH8hNEApE8E5sXi_1t",
        "TQVKTrHIlBQ9r5gZS0KVE",
        "P2lSXhkoiY6ZSTMDAGx5Z",
        "i3mgUS56dRyRmYsnPyocR"
      ],
      "frameId": null,
      "index": "bQZ",
      "roundness": null,
      "seed": 1987561404,
      "version": 1663,
      "versionNonce": 605570180,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877010484,
      "link": null,
      "locked": false,
      "text": "O AWS Control Tower é um serviço gerenciado que\nautomatiza a criação e governança de um ambiente\nmulti-conta seguro e padronizado (Landing Zone),\nseguindo as melhores práticas recomendadas. Facilita a\nimplementação de estrutura organizacional, políticas de\nsegurança e conformidade sem necessidade de\nconfiguração manual avançada. Usa o CloudFormation\npara criar recursos",
      "fontSize": 13.64770392855499,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O AWS Control Tower é um serviço gerenciado que automatiza a criação e governança de um ambiente multi-conta seguro e padronizado (Landing Zone), seguindo as melhores práticas recomendadas. Facilita a implementação de estrutura organizacional, políticas de segurança e conformidade sem necessidade de configuração manual avançada. Usa o CloudFormation para criar recursos",
      "autoResize": false,
      "lineHeight": 1.25
    },
