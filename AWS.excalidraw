      "frameId": null,
      "index": "bYl",
      "roundness": null,
      "seed": 1078372008,
      "version": 1752,
      "versionNonce": 1623992972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764941946504,
      "link": null,
      "locked": false,
      "text": "É sempre bom fazer snapshots depois de um tempo de uso do EBS.\nNão é necessário desassociar o EBS de uma instância para fazer um\nsnapshot mas é recomendado. Fazer snapshots é bom para recuperar\ndados, e permite mover os dados de um EBS de uma AZ para outra. \n",
      "fontSize": 11.015193748801929,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "É sempre bom fazer snapshots depois de um tempo de uso do EBS.\nNão é necessário desassociar o EBS de uma instância para fazer um snapshot mas é recomendado. Fazer snapshots é bom para recuperar dados, e permite mover os dados de um EBS de uma AZ para outra. \n",
      "autoResize": false,
      "lineHeight": 1.25
    },
