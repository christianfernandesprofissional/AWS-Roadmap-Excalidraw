    },
    {
      "id": "WIVZByhpeBEqyjfXk6Qrg",
      "type": "text",
      "x": -4577.647946997168,
      "y": -550.8227142201805,
      "width": 210.1341515787895,
      "height": 130.94776770059002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PJzpEysafoj9XtvS4WQum",
        "Z7ZIq0fonu04a8nryl2rm",
        "Shdq8ISqpB-j3PJCEj8Jc",
        "n3nBmubOt2oIg6NuG5wkR"
      ],
      "frameId": null,
      "index": "bXH",
      "roundness": null,
      "seed": 1927508996,
      "version": 1751,
      "versionNonce": 486090116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877563024,
      "link": null,
      "locked": false,
      "text": "Criptografia e gerenciamento de chaves.\nAs chaves do AWS KMS são usadas para\ncriptografar e descriptografar seus\ndados usando o AWS Encryption SDK ou\na AWS CLI.\nThe KMS keys that you create are\ncustomer managed keys (CMK). Chaves\ngerenciadas pelo cliente são chaves KMS\nem sua conta da AWS que você cria,\npossui e gerencia.",
      "fontSize": 10.475821416047202,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Criptografia e gerenciamento de chaves.\nAs chaves do AWS KMS são usadas para criptografar e descriptografar seus dados usando o AWS Encryption SDK ou a AWS CLI.\nThe KMS keys that you create are customer managed keys (CMK). Chaves gerenciadas pelo cliente são chaves KMS em sua conta da AWS que você cria, possui e gerencia.",
      "autoResize": false,
      "lineHeight": 1.25
    },
