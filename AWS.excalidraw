    {
      "id": "5BT6ge4XTqkEVg6K3tFIf",
      "type": "text",
      "x": -1397.160293843259,
      "y": -2451.218340096944,
      "width": 294.6759037132874,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FScDatdNi3tTPiG1241dV",
        "Zgaapypo-Py5GoIXBWyEN",
        "p0v2M8arybpa4fB5DOIhU",
        "hD8u3bB7kRjOX_XGaohJQ"
      ],
      "frameId": null,
      "index": "bdC",
