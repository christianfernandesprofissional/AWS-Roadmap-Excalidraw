      "isDeleted": false,
      "boundElements": [],
      "updated": 1764183839138,
      "link": null,
      "locked": false,
      "text": "Podem ser do tipo Interface\n(para APIs em geral) ou Gateway\n(exclusivo para S3 e DynamoDB),\nproporcionando comunicação\nprivada com esses serviços.",
      "fontSize": 16.6295534541332,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Podem ser do tipo Interface (para APIs em geral) ou Gateway (exclusivo para S3 e DynamoDB), proporcionando comunicação privada com esses serviços.",
      "autoResize": false,
      "lineHeight": 1.25
    },
