    {
      "id": "oFA5ppBi2Ux_7lfXQ0mCw",
      "type": "text",
      "x": 1286.7665294543979,
      "y": 714.8010543278235,
      "width": 295.21869365594995,
      "height": 88.27580945677609,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2DgoAucWTtXHcaOwZsOR5",
        "i3mgUS56dRyRmYsnPyocR"
      ],
      "frameId": null,
      "index": "bQK",
      "roundness": null,
      "seed": 1228784552,
      "version": 1405,
      "versionNonce": 1809816580,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877010484,
      "link": null,
      "locked": false,
      "text": "O EventBridge é a funcionalidade baseada em eventos do\nCloudWatch que permite reagir automaticamente a mudanças\nna AWS ou em aplicações externas (SaaS). Também é como\nse você agendasse cron jobs.\n\nEle detecta eventos e executa ações automaticamente,\nfuncionando como um sistema de automação.",
      "fontSize": 10.088663937917268,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O EventBridge é a funcionalidade baseada em eventos do CloudWatch que permite reagir automaticamente a mudanças na AWS ou em aplicações externas (SaaS). Também é como se você agendasse cron jobs.\n\nEle detecta eventos e executa ações automaticamente, funcionando como um sistema de automação.",
      "autoResize": false,
      "lineHeight": 1.25
    },
