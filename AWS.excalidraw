    {
      "id": "XX9Mv5nlwCjnt_bTAh-Mh",
      "type": "text",
      "x": 2544.766627474016,
      "y": -2056.515920027752,
      "width": 414.7129991319446,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pHMp53vut_B9hAhNWkf-I"
      ],
      "frameId": null,
      "index": "bat",
      "roundness": null,
      "seed": 1975412028,
      "version": 263,
      "versionNonce": 693689276,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764876323476,
      "link": null,
      "locked": false,
      "text": "A AWS Partner Network (APN) é o\nprograma global de parcerias para\nempresas de tecnologia e consultoria que\nutilizam a Amazon Web Services para criar\nsoluções e serviços para seus clientes.\n\nOs Parceiros de Consultoria da APN são\nempresas de serviços profissionais que\najudam clientes de todos os tipos e\nportes a projetar, arquitetar, construir,\nmigrar e gerenciar suas cargas de trabalho\ne aplicativos na AWS, acelerando sua\nmigração para a nuvem da AWS.",
      "fontSize": 19.999999999999996,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A AWS Partner Network (APN) é o programa global de parcerias para empresas de tecnologia e consultoria que utilizam a Amazon Web Services para criar soluções e serviços para seus clientes.\n\nOs Parceiros de Consultoria da APN são empresas de serviços profissionais que ajudam clientes de todos os tipos e portes a projetar, arquitetar, construir, migrar e gerenciar suas cargas de trabalho e aplicativos na AWS, acelerando sua migração para a nuvem da AWS.",
      "autoResize": false,
      "lineHeight": 1.25
    },
