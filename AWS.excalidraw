    },
    {
      "id": "1kHr4w7vWMxaVuQu6XpHY",
      "type": "text",
      "x": -2248.8437203075005,
      "y": 3756.212327533066,
      "width": 415.13776931111806,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yK7Wsyce3Qv5hR3gaKHP8",
        "Fc6i8J6Bza-wD0oDi2FHm",
        "eDTn0C6ys7ZZFhKFD7an_",
        "yXXvCKS21TZTGAv_1HI-y"
      ],
      "frameId": null,
      "index": "bWr",
      "roundness": null,
      "seed": 261110673,
      "version": 562,
      "versionNonce": 771988796,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877384187,
      "link": null,
      "locked": false,
      "text": "Envision (Visualizar) –\ndemonstrar como a\nnuvem acelerará os\nresultados de negócios,\nidentificando\noportunidades de\ntransformação e\ncriando uma base para\nsua transformação\ndigital.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Envision (Visualizar) – demonstrar como a nuvem acelerará os resultados de negócios, identificando oportunidades de transformação e criando uma base para sua transformação digital.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "o31SQb1QI2A-mrOaRFD5A",
      "type": "text",
      "x": -1768.6667211105037,
      "y": 3756.073751956501,
      "width": 396.8329602478894,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yK7Wsyce3Qv5hR3gaKHP8",
        "Fc6i8J6Bza-wD0oDi2FHm",
        "eDTn0C6ys7ZZFhKFD7an_",
        "yXXvCKS21TZTGAv_1HI-y"
      ],
      "frameId": null,
      "index": "bWs",
      "roundness": null,
      "seed": 491766271,
      "version": 606,
      "versionNonce": 1385469372,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877384187,
      "link": null,
      "locked": false,
      "text": "Align (Alinhar) –\nidentificar lacunas de\ncapacidade nas 6\nperspectivas do AWS\nCAF, resultando em um\nPlano de Ações.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Align (Alinhar) – identificar lacunas de capacidade nas 6 perspectivas do AWS CAF, resultando em um Plano de Ações.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "nEIS8tfjnsl5asXeKTnv7",
      "type": "text",
      "x": -1293.3391882576802,
      "y": 3751.8926870043915,
      "width": 400.90039135279403,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yK7Wsyce3Qv5hR3gaKHP8",
        "Fc6i8J6Bza-wD0oDi2FHm",
        "eDTn0C6ys7ZZFhKFD7an_",
        "yXXvCKS21TZTGAv_1HI-y"
      ],
      "frameId": null,
      "index": "bWt",
      "roundness": null,
      "seed": 1912906097,
      "version": 561,
      "versionNonce": 460488252,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877384187,
      "link": null,
      "locked": false,
      "text": "Launch (Lançar) –\nconstruir e entregar\niniciativas piloto em\nprodução,\ndemonstrando valor\nincremental para o\nnegócio.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Launch (Lançar) – construir e entregar iniciativas piloto em produção, demonstrando valor incremental para o negócio.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "64ULgOgWgTimhtTMEhFcp",
      "type": "text",
      "x": -851.0808154404822,
      "y": 3760.384929532069,
      "width": 369.71968269066184,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yK7Wsyce3Qv5hR3gaKHP8",
        "Fc6i8J6Bza-wD0oDi2FHm",
        "eDTn0C6ys7ZZFhKFD7an_",
        "yXXvCKS21TZTGAv_1HI-y"
      ],
      "frameId": null,
      "index": "bWu",
      "roundness": null,
      "seed": 388311583,
      "version": 612,
      "versionNonce": 1367299772,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764877384187,
      "link": null,
      "locked": false,
      "text": "Scale (Escalar) –\nexpandir as\niniciativas piloto até\na escala desejada,\nalcançando os\nbenefícios de negócio\npretendidos.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scale (Escalar) – expandir as iniciativas piloto até a escala desejada, alcançando os benefícios de negócio pretendidos.",
      "autoResize": false,
      "lineHeight": 1.25
    },
