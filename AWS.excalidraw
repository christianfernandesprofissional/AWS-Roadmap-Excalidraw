      "link": null,
      "locked": false,
      "text": "📄 Policies (Políticas)\n\nDocumentos JSON que definem permissões de acesso.\n\nPodem ser aplicadas a Users, Groups ou Roles.\n\nEspecificam ação + recurso + condição.",
      "fontSize": 13.550780229137017,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "📄 Policies (Políticas)\n\nDocumentos JSON que definem permissões de acesso.\n\nPodem ser aplicadas a Users, Groups ou Roles.\n\nEspecificam ação + recurso + condição.",
      "autoResize": false,
      "lineHeight": 1.25
    },
