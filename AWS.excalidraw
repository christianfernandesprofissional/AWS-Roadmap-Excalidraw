      "x": 869.1159805167404,
      "y": 343.2708311030274,
      "width": 345.78291803995785,
      "height": 101.25000000000004,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
