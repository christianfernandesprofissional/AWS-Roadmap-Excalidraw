    {
      "id": "c1aJmLNUOKJAb_1fo0eid",
      "type": "text",
      "x": -2639.904473433558,
      "y": 1207.371842301347,
      "width": 319.70294622157917,
      "height": 106.5249253477384,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AgyKmYH1roW8wUZLYXRta",
        "RBi2NZWwBC8qIUtisgF2w",
        "LX83Vn8S1ryft-eSufgMc"
      ],
      "frameId": null,
      "index": "bSM",
      "roundness": null,
      "seed": 1294132356,
      "version": 1234,
      "versionNonce": 1433098634,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768322551804,
      "link": null,
      "locked": false,
      "text": "Cache em memória para acelerar o DynamoDB (performance\naté 10x melhor). DAX ACELERA LEITURAS, NÂO ESCRITAS.\n\nE a diferença com o ElastiCache é que o DAX é totalmente\nintegrado ao DynamoDB. Enquanto o ElastiCache pode ser\nusado para outros tipos de bancos de dados para fornecer\nrecursos de armazenamento em cache. (Para DynamoDB\nprefira DAX)",
      "fontSize": 10.65249253477384,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cache em memória para acelerar o DynamoDB (performance até 10x melhor). DAX ACELERA LEITURAS, NÂO ESCRITAS.\n\nE a diferença com o ElastiCache é que o DAX é totalmente integrado ao DynamoDB. Enquanto o ElastiCache pode ser usado para outros tipos de bancos de dados para fornecer recursos de armazenamento em cache. (Para DynamoDB prefira DAX)",
      "autoResize": false,
      "lineHeight": 1.25
    },
