    {
      "id": "wtEwYmeRJ5uAaomaIfap5",
      "type": "text",
      "x": -1550.9364320917796,
      "y": 153.96007398305784,
      "width": 370.50289452951,
      "height": 68.84496093001205,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "p8KO7xuYKw8h-nhmpQju8",
        "Od54y6YZXviMWo_Ya97pO",
        "iOdt95jzDikVOjwg1LVgY",
        "duSqr4yzlqyh6IvrLN8ke"
      ],
      "frameId": null,
      "index": "bFT",
      "roundness": null,
      "seed": 1078372008,
      "version": 1698,
      "versionNonce": 1971777101,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763838515948,
      "link": null,
      "locked": false,
      "text": "É sempre bom fazer snapshots depois de um tempo de uso do EBS.\nNão é necessário desassociar o EBS de uma instância para fazer um\nsnapshot mas é recomendado. Fazer snapshots é bom para recuperar\ndados, e permite mover os dados de um EBS de uma AZ para outra. \n",
      "fontSize": 11.015193748801929,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "É sempre bom fazer snapshots depois de um tempo de uso do EBS.\nNão é necessário desassociar o EBS de uma instância para fazer um snapshot mas é recomendado. Fazer snapshots é bom para recuperar dados, e permite mover os dados de um EBS de uma AZ para outra. \n",
      "autoResize": false,
      "lineHeight": 1.25
    },
