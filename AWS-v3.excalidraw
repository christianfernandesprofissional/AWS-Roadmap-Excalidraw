    {
      "id": "iKs8T0EcMa0XCaeLGez7y",
      "type": "text",
      "x": -1095.2925386043262,
      "y": -3284.2569725511203,
      "width": 167.4045036098799,
      "height": 124.43734540441588,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UJbJHNp_Qspv81vQHpgGS",
        "SF395_L9Xj9tiXMQqIWzc",
        "z6omCnTBwmbjQOFCVM2xB",
