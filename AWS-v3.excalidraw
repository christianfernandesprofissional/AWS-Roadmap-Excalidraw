    {
      "id": "vsP7wEqOV7Dx_9_ncwKC1",
      "type": "text",
      "x": 337.39370284945244,
      "y": 1678.5124120285213,
      "width": 231.81028515625002,
      "height": 142,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3aML-5tX4LZZbMXCId1Mx",
        "a3MY1ERXpP6592cukwIsz"
      ],
      "frameId": null,
      "index": "bCJ",
      "roundness": null,
      "seed": 1450322039,
      "version": 733,
      "versionNonce": 448466125,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763838540152,
      "link": null,
      "locked": false,
      "text": "Amazon Lex: Serviço da AWS que permite\ncriar chatbots e assistentes virtuais com\nreconhecimento de voz e linguagem\nnatural, similar ao usado pela Alexa.\n\nAmazon Connect: Serviço de central de\natendimento em nuvem que permite criar\ncontact centers com chat, voz e\nintegração com IA (como o Lex) de forma\nescalável e econômica.",
      "fontSize": 11.359999999999998,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amazon Lex: Serviço da AWS que permite criar chatbots e assistentes virtuais com reconhecimento de voz e linguagem natural, similar ao usado pela Alexa.\n\nAmazon Connect: Serviço de central de atendimento em nuvem que permite criar contact centers com chat, voz e integração com IA (como o Lex) de forma escalável e econômica.",
      "autoResize": false,
      "lineHeight": 1.25
    },
