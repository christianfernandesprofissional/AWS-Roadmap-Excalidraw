    {
      "id": "4DZNJS3SAORHIB9TAM7rX",
      "type": "text",
      "x": 1062.70358757607,
      "y": -3052.414486200962,
      "width": 311.5511667743797,
      "height": 113.43041537480394,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DJCKIQzH5uvTsQ7VAxn0W",
        "gORx82CSBAPwC1qGpivgZ",
        "CfOA8-R9uxmXrT_mNOwDF",
        "sxeCs55krjL107nuolub6"
      ],
      "frameId": null,
