      "versionNonce": 2011529357,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763838520049,
      "link": null,
      "locked": false,
      "text": "Serviço de monitoramento, observabilidade e\nautomação de respostas da AWS. Ele permite\ncoletar métricas, logs e eventos dos recursos da\nAWS e de aplicações, acompanhar o desempenho em\ntempo real, criar alertas e reagir automaticamente a\nproblemas ou mudanças.",
      "fontSize": 13.500000000000007,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serviço de monitoramento, observabilidade e automação de respostas da AWS. Ele permite coletar métricas, logs e eventos dos recursos da AWS e de aplicações, acompanhar o desempenho em tempo real, criar alertas e reagir automaticamente a problemas ou mudanças.",
      "autoResize": false,
      "lineHeight": 1.25
    },
