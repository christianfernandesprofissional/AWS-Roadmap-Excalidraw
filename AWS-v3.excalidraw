    {
      "id": "JAwij3skW31eDkEF5R7E6",
      "type": "text",
      "x": -1425.2165040713471,
      "y": -3275.74160621085,
      "width": 241.83327781880382,
      "height": 103.41737735044262,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xof1EcpjEIUr1OasyXvfX",
        "SF395_L9Xj9tiXMQqIWzc",
        "z6omCnTBwmbjQOFCVM2xB",
        "CdUPIg7W6e7bhXxrKsjMN"
      ],
      "frameId": null,
      "index": "bPF",
      "roundness": null,
      "seed": 1454212100,
      "version": 809,
      "versionNonce": 1869897571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763837296552,
      "link": null,
      "locked": false,
      "text": "O Amazon ECS é um serviço totalmente gerenciado\nde orquestração de containers, usado para executar\naplicações em containers (como Docker) na AWS.\n\nVocê deve provisionar e manter a infraestrutura por\nconta própria.I sso significa que você precisa criar\ninstâncias EC2 com antecedência. A AWS se\nencarregará de iniciar ou interromper os contêineres\npara você, e tem integração com um Load Balancer",
      "fontSize": 9.192655764483789,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O Amazon ECS é um serviço totalmente gerenciado de orquestração de containers, usado para executar aplicações em containers (como Docker) na AWS.\n\nVocê deve provisionar e manter a infraestrutura por conta própria.I sso significa que você precisa criar instâncias EC2 com antecedência. A AWS se encarregará de iniciar ou interromper os contêineres para você, e tem integração com um Load Balancer",
      "autoResize": false,
      "lineHeight": 1.25
    },
