    {
      "id": "NmXf75lFEert1I5oMCPAn",
      "type": "text",
      "x": -3792.943489097932,
      "y": 924.8077123992257,
      "width": 194.9392457916527,
      "height": 90.6533506067485,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "voy6NJEyojzn7ibuzRhfq",
        "LX83Vn8S1ryft-eSufgMc"
      ],
      "frameId": null,
      "index": "bGnq",
      "roundness": null,
      "seed": 268440380,
      "version": 740,
      "versionNonce": 1781876461,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763838554412,
      "link": null,
      "locked": false,
      "text": "Um serviço gerenciado que permite\nmigrar bancos de dados para a AWS\nde forma rápida, segura e com mínima\ninterrupção.\nEle suporta migrações entre bancos\ndo mesmo tipo (homogêneas) ou de\ntipos diferentes (heterogêneas).",
      "fontSize": 10.360382926485544,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Um serviço gerenciado que permite migrar bancos de dados para a AWS de forma rápida, segura e com mínima interrupção.\nEle suporta migrações entre bancos do mesmo tipo (homogêneas) ou de tipos diferentes (heterogêneas).",
      "autoResize": false,
      "lineHeight": 1.25
    },
