        }
      ],
      "updated": 1763838554412,
      "link": null,
      "locked": false,
      "text": "O Amazon DocumentDB é um banco de dados NoSQL\norientado a documentos, totalmente gerenciado e\ncompatível com MongoDB.\nIsso significa que aplicações que usam MongoDB podem\nfuncionar com DocumentDB praticamente sem mudanças.",
      "fontSize": 10.068273318197223,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O Amazon DocumentDB é um banco de dados NoSQL orientado a documentos, totalmente gerenciado e compatível com MongoDB.\nIsso significa que aplicações que usam MongoDB podem funcionar com DocumentDB praticamente sem mudanças.",
      "autoResize": false,
      "lineHeight": 1.25
    },
