      "boundElements": [],
      "updated": 1763837296552,
      "link": null,
      "locked": false,
      "text": "Standard RI → maior\ndesconto, mas menos flexível\n(tipo e região fixos).\n\nConvertible RI → desconto\nmenor, mas permite trocar\ntipo/família de instância.",
      "fontSize": 19.948697072333204,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Standard RI → maior desconto, mas menos flexível (tipo e região fixos).\n\nConvertible RI → desconto menor, mas permite trocar tipo/família de instância.",
      "autoResize": false,
      "lineHeight": 1.25
    },
