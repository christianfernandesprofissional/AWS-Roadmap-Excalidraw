      "isDeleted": false,
      "boundElements": [],
      "updated": 1763838515948,
      "link": null,
      "locked": false,
      "text": "Permite definir regras para reter\nsnapshots excluídos, possibilitando\nrecuperá-los em caso de exclusão\nacidental.\nÉ possível especificar o tempo de\nretenção, de 1 dia até 1 ano.",
      "fontSize": 11.015193748801929,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Permite definir regras para reter snapshots excluídos, possibilitando recuperá-los em caso de exclusão acidental.\nÉ possível especificar o tempo de retenção, de 1 dia até 1 ano.",
      "autoResize": false,
      "lineHeight": 1.25
    },
