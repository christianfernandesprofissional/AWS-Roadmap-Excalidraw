    {
      "id": "v1QNAM9sPgXBVs9I6oZFY",
      "type": "text",
      "x": 703.3725041411485,
      "y": 694.0363253153658,
      "width": 275.12704026060834,
      "height": 113.49746930156927,
      "angle": 0,
      "strokeColor": "#1e1e1e",
