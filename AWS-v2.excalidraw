    {
      "id": "OXmj0y4FrZgrY7Y3xtxMF",
      "type": "text",
      "x": -5.481932000526285,
      "y": -4396.507933572039,
      "width": 148.01114070102133,
      "height": 49.92131067761102,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QJK2ZfDfORjPoZp9SVFp-",
        "OE3MUMtpv9O38aZA7IAsj"
      ],
      "frameId": null,
      "index": "b9Y",
      "roundness": null,
      "seed": 1064431758,
      "version": 269,
      "versionNonce": 116308727,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763754640413,
      "link": null,
      "locked": false,
      "text": "Serviço que fornece sistemas de arquivos\ntotalmente gerenciados e otimizados para\ndiferentes necessidades — como Windows File\nServer, Lustre, NetApp ONTAP e OpenZFS —\noferecendo desempenho e compatibilidade com\naplicações específicas.",
      "fontSize": 6.656174757014799,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serviço que fornece sistemas de arquivos totalmente gerenciados e otimizados para diferentes necessidades — como Windows File Server, Lustre, NetApp ONTAP e OpenZFS — oferecendo desempenho e compatibilidade com aplicações específicas.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
